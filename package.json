{
  "name": "ai-teacher-assistant",
  "private": true,
  "version": "0.1.0",
  "description": "AI Teacher Assistant desktop application (Tauri 2 + React + TypeScript + FastAPI)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "backend:install": "python -m pip install -r requirements.txt",
    "backend:dev": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
    "backend:test": "python -m pytest backend/tests"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
